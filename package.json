{
  "name": "wafflr",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:generate": "pnpm --filter @wafflr/config tokens:generate",
    "tokens:check": "pnpm --filter @wafflr/config tokens:check"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
