{
  "name": "wafflr",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm tokens:check && turbo dev",
    "build": "pnpm tokens:check && turbo build",
    "lint": "pnpm tokens:check && turbo lint",
    "typecheck": "pnpm tokens:check && turbo typecheck",
    "tokens:build": "node packages/config/scripts/generate-tokens.mjs",
    "tokens:check": "node packages/config/scripts/generate-tokens.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
